# ============================================================================
#  shop/media — photos produit envoyées depuis la console.
#  Le contenu de ce dossier vient d'un formulaire d'envoi. Même ré-encodé, il
#  ne doit JAMAIS être exécuté : on coupe tout moteur de script, et on ne sert
#  que des images. Une image parfaitement valide contenant du PHP finit ici
#  téléchargée, jamais interprétée.
# ============================================================================

php_flag engine off
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps

<FilesMatch "\.(php|phtml|php[0-9]|phps|cgi|pl|py|sh|htaccess)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Content-Disposition "inline"
  # Les noms de fichiers sont tirés au sort : le contenu ne change jamais.
  Header always set Cache-Control "public, max-age=31536000, immutable"
</IfModule>
