# ============================================================================
#  Mister Szoko — en-têtes de sécurité du site (/mrszoko).
#  Déployé à la racine du site. Le bloc de redirection HTTPS n'est PAS ici :
#  le déploiement l'ajoute uniquement après avoir VÉRIFIÉ que TLS répond sur
#  le serveur (imposer https sans certificat fonctionnel casserait le site).
# ============================================================================

<IfModule mod_headers.c>
  # Pas d'interprétation de type devinée (protège des réponses détournées).
  Header always set X-Content-Type-Options "nosniff"
  # Pas d'intégration dans une iframe tierce (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Ne fuite pas l'URL complète vers les sites externes.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Aucune API sensible du navigateur n'est utilisée par ce site.
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
</IfModule>

# Le back-office et son API ne doivent jamais être mis en cache par un
# intermédiaire : les réponses dépendent de la session.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>
